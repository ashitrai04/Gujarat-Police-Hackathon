# ── Required ────────────────────────────────────────────────────────────
# Mapbox GL access token — https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=

# Camera-grid access key (the XXXX-XXXX-XXXX code from the organisers).
# SERVER-SIDE ONLY. No VITE_ prefix, so Vite never inlines it into the
# browser bundle — the dev proxy and the Vercel Edge function sign in with
# it and attach the resulting session cookie themselves.
# On Vercel: Settings > Environment Variables, same name.
SENTINEL_ACCESS_KEY=

# Supabase — the camera registry, roles, audit trail and detections.
# Without these the app still runs, but on the live grid catalogue only:
# read-only, no onboarding, no audit, no roles.
# Project settings > API. The anon key is public by design; row-level
# security is what protects the data, not the key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Recorded-feed fallback. Base URL of the object store (Cloudflare R2 public
# bucket or custom domain) holding the packaged HLS archive. Blank disables
# the fallback entirely — tiles then show "Stream unavailable" instead.
# Layout expected: <base>/<cameraId>/index.m3u8
VITE_FALLBACK_BASE=
# Capture date shown on the RECORDED badge, so the label agrees with the
# timestamp burned into the footage.
VITE_FALLBACK_DATE=14 Jun 2026

# ── Optional ────────────────────────────────────────────────────────────
# ANPR pipeline base URL. Blank ⇒ the UI reports "ANPR offline" and renders
# empty states rather than inventing detections.
VITE_ANPR_API_URL=

# Override the proxy path the browser calls. Leave blank in normal use:
# both dev and production serve the grid at /sentinel.
VITE_SENTINEL_HOST=
VITE_STREAM_BASE=
