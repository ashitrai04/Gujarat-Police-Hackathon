# ── Required ────────────────────────────────────────────────────────────
# Mapbox GL access token — https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=

# Camera-grid access key (the XXXX-XXXX-XXXX code from the organisers).
# SERVER-SIDE ONLY. No VITE_ prefix, so Vite never inlines it into the
# browser bundle — the dev proxy and the Vercel Edge function sign in with
# it and attach the resulting session cookie themselves.
# On Vercel: Settings > Environment Variables, same name.
# The grid now requires the registered email alongside the key; a password-only
# sign-in is answered 200 with the login form re-rendered, which looks like a
# broken feed rather than a rejected login.
SENTINEL_ACCESS_EMAIL=
SENTINEL_ACCESS_KEY=

# Supabase — the camera registry, roles, audit trail and detections.
# Without these the app still runs, but on the live grid catalogue only:
# read-only, no onboarding, no audit, no roles.
# Project settings > API. The anon key is public by design; row-level
# security is what protects the data, not the key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Recorded-feed fallback. Base URL of the object store (Cloudflare R2 public
# bucket or custom domain) holding the packaged HLS archive. Blank disables
# the fallback entirely — tiles then show "Stream unavailable" instead.
# Layout expected: <base>/<cameraId>/index.m3u8
VITE_FALLBACK_BASE=
# Capture date shown on the RECORDED badge, so the label agrees with the
# timestamp burned into the footage.
VITE_FALLBACK_DATE=14 Jun 2026

# ── Optional ────────────────────────────────────────────────────────────
# ANPR pipeline base URL. Blank ⇒ the UI reports "ANPR offline" and renders
# empty states rather than inventing detections.
VITE_ANPR_API_URL=

# Override the proxy path the browser calls. Leave blank in normal use:
# both dev and production serve the grid at /sentinel.
VITE_SENTINEL_HOST=
VITE_STREAM_BASE=

# Prompt-search service (pipeline/ask). Blank ⇒ the Ask panel reports
# "Prompt search offline" rather than showing empty results.
# The service holds SigLIP 2 and a local Qwen2.5-VL resident and needs a GPU,
# so it runs beside the inference worker, not on the web tier:
#   python -m ask.serve --port 8077
# Never expose it to the internet: it has no auth of its own.
VITE_ASK_API_URL=

# Shared token for the prompt-search service. Only needed when that service is
# reachable from outside this machine (a tunnel, so a hosted page can use it).
# It ships in the browser bundle by necessity — the browser is what calls the
# service — so it stops scanners, not someone who has the link. Set the same
# value as ASK_TOKEN in the service's shell.
VITE_ASK_TOKEN=

# Reserved ngrok domain, so the search service keeps ONE address across
# restarts and a hosted page never needs repointing. Free tier includes one:
# dashboard.ngrok.com > Domains > Create. Used by `.\start.ps1 -Tunnel`.
# Without it the script falls back to a throwaway tunnel whose hostname
# changes every time, which cannot be configured once and left alone.
NGROK_DOMAIN=
