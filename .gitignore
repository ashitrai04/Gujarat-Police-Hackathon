.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# test + scratch output
.playwright-mcp
coverage
*.local

# Source GeoPackage — layers are exported to public/geo as GeoJSON
gujarat_shp

# Packaged HLS archive lives in object storage, not the repo
/feed_recordings_hls/

# The detection pipeline is cloned at run time, not vendored
/pipeline/sentinel-gujarat-pipeline/
/pipeline/_capture/
/pipeline/*.log

# Worker credentials — service-role key, never commit
/pipeline/.env.worker
