# Copy to .env.worker and fill in. .env.worker is gitignored; this file is not,
# so nothing real belongs here.
#
# SUPABASE_SERVICE_KEY is the service_role key, which bypasses row-level
# security completely. It belongs on a server and in nothing a browser can
# reach -- not a VITE_ variable, not a committed script, not a screenshot.
# If it has ever been shown anywhere, rotate it: Supabase -> Project Settings
# -> API -> Reset service_role. Deleting it from a file does not un-publish it.

SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_KEY=<service_role key>

# The camera grid wants both, and refuses a key-only sign-in with a 200 and
# the login form rather than an error.
SENTINEL_ACCESS_EMAIL=<registered email>
SENTINEL_ACCESS_KEY=<grid access key>

# The detection pipeline, which is not in the Git repository. Relative to the
# pipeline directory in a normal checkout.
SENTINEL_PIPELINE_DIR=./sentinel-gujarat-pipeline

# Optional. Chosen from free VRAM when unset: accurate | balanced | fast
# SENTINEL_PROFILE=balanced

# Optional, for crowd / fire / accident. Defaults are starting points and
# should be set from what events_test() measures on your own footage.
# SENTINEL_CROWD_MEDIUM=25
# SENTINEL_CROWD_HIGH=60
# SENTINEL_FIRE_THRESHOLD=0.08
# SENTINEL_ACCIDENT_THRESHOLD=0.05
